# Salin file ini jadi .env.local untuk pengembangan lokal,
# dan isikan nilai yang sama sebagai Environment Variables di dashboard Vercel.

# Upstash Redis (REST API) — penyimpanan utama database
UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxx

# URL publik aplikasi, dipakai untuk link donatur
PUBLIC_BASE_URL=https://lazdigital.my.id

# Opsional: secret tambahan
DB_SECRET=
