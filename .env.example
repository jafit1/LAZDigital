# Salin file ini jadi .env.local untuk pengembangan lokal,
# dan isikan nilai yang sama sebagai Environment Variables di dashboard Vercel.

# ============================================================
# PENYIMPANAN UTAMA — PostgreSQL (Supabase)
# ============================================================
# Ini yang dipakai sekarang. Begitu DATABASE_URL terisi, seluruh buku besar
# (Penghimpunan, Pentasyarufan, Users, dst) dan seluruh data modul AI,
# Broadcast, dan Fundraising memakai PostgreSQL. UPSTASH_* di bawah tidak lagi
# disentuh oleh bagian-bagian itu.
#
# WAJIB memakai alamat "Transaction pooler" Supabase (porta 6543), BUKAN
# sambungan langsung porta 5432. Di Vercel tiap permintaan bisa mendarat di
# proses yang berbeda dan tiap proses membuka sambungannya sendiri; sambungan
# langsung akan habis jauh sebelum penggunanya bertambah banyak.
# Ambil di Supabase: Project Settings -> Database -> Connection string ->
# Transaction pooler. Ganti [YOUR-PASSWORD] dengan sandi basis data.
DATABASE_URL=postgresql://postgres.xxxxxxxx:SANDI@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# Banyaknya sambungan per proses. 2 sudah cukup dan sengaja kecil.
# PG_MAKS_SAMBUNGAN=2

# ============================================================
# Upstash Redis — TIDAK lagi dipakai buku besar
# ============================================================
# Masih dipakai HANYA oleh Broadcast versi lama (api/wa.js + broadcast.html,
# kunci berawalan wab:). Kalau halaman itu tidak dipakai lagi, kedua baris ini
# boleh dikosongkan. Kalau DATABASE_URL dikosongkan, aplikasi kembali memakai
# Redis seperti sebelum pemindahan — itu jalan pulang kalau ada masalah.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# URL publik aplikasi, dipakai untuk link donatur
PUBLIC_BASE_URL=https://lazdigital.my.id

# Opsional: secret tambahan
DB_SECRET=

# ---- Cadangan otomatis (lihat PANDUAN-CADANGAN.md) ----
# Kunci rahasia agar /api/backup hanya bisa dipicu oleh cron Vercel.
# Wajib diisi supaya cadangan harian aktif. Buat teks acak panjang.
CRON_SECRET=

# Google Drive lewat OAuth akun Anda sendiri (bukan service account).
# Dapatkan lewat: node tools/dapatkan-token-drive.js <CLIENT_ID> <CLIENT_SECRET>
GDRIVE_CLIENT_ID=
GDRIVE_CLIENT_SECRET=
GDRIVE_REFRESH_TOKEN=
# ID folder tujuan: bagian setelah /folders/ pada alamat folder di Drive
GDRIVE_FOLDER_ID=

# ---- Scan kwitansi: pembacaan otomatis oleh AI (lihat PANDUAN-SCAN-KWITANSI.md) ----
# Kosongkan OCR_API_KEY untuk mematikan fitur ini; formulir tetap bisa diisi manual.
# JANGAN pernah menaruh kunci ini di dalam kode atau vercel.json — repositori publik.
OCR_PENYEDIA=gemini
OCR_API_KEY=
# Opsional. RANTAI model dipisah koma, dicoba berurutan. Kalau kuota gratis
# model pertama habis, sistem otomatis pindah ke model berikutnya dan model
# yang habis diistirahatkan sampai kuota harian pulih.
# PAKAI ALIAS "-latest", jangan versi bernomor: model bernomor punya masa
# pensiun dan panggilannya mulai dibalas 404 walau masih terdaftar.
# Bawaan gemini : gemini-flash-latest,gemini-flash-lite-latest,gemini-pro-latest
# Bawaan openai : gpt-4o-mini
OCR_MODEL=
# Opsional. Batas berapa kwitansi boleh dibaca AI per hari (pagar biaya). Bawaan 300.
OCR_BATAS_HARIAN=300

# ---- Modul Broadcast --------------------------------------------------------
# Kunci penanda sesi Broadcast dan tanda tangan webhook keluar. Acak, panjang.
# Kalau kosong, halaman Broadcast tetap jalan tetapi webhook keluar tidak
# ditandatangani — penerimanya tidak bisa memastikan kiriman itu dari Anda.
RAHASIA_SESI=

# Cara pesan dikirim, dipakai saat basis data masih kosong sama sekali.
# Sesudah itu yang berlaku adalah pilihan di Broadcast > Pengaturan, bukan ini.
#   sandbox  = simulasi, TIDAK ADA pesan yang benar-benar terkirim (bawaan)
#   mandiri  = gateway WhatsApp sendiri (lihat BLAST_AGEN_TOKEN di bawah)
#   fonnte   = layanan pihak ketiga
#   meta     = WhatsApp Cloud API resmi
PENGIRIM=mandiri

# ---- Gateway WhatsApp sendiri (pengganti Fonnte) ----------------------------
# Satu token mesin yang dipakai gateway di komputer kantor / VPS untuk menarik
# antrean lewat /api/blast-agen. BUKAN sandi amil: endpoint itu tidak mengenal
# akun pengguna sama sekali.
# Buat yang panjang dan acak, misalnya dengan:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Isi nilai yang sama di berkas laz.json milik gateway.
# JANGAN ditaruh di kode atau vercel.json — repositori ini publik.
# Selama masih kosong, /api/blast-agen menolak semua permintaan (ditutup, bukan dibuka).
BLAST_AGEN_TOKEN=
#
# CATATAN: antrean Broadcast TIDAK butuh cron Vercel. Gateway-lah yang mendorong
# antreannya sendiri setiap kali menarik pekerjaan (dibatasi sekali per 15 detik).
# Paket Hobby hanya mengizinkan cron sekali sehari — kalau mengandalkan cron,
# pesan akan menumpuk sampai besok.
