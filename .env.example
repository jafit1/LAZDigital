# Salin file ini jadi .env.local untuk pengembangan lokal,
# dan isikan nilai yang sama sebagai Environment Variables di dashboard Vercel.

# Upstash Redis (REST API) — penyimpanan utama database
UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxx

# URL publik aplikasi, dipakai untuk link donatur
PUBLIC_BASE_URL=https://lazdigital.my.id

# Opsional: secret tambahan
DB_SECRET=

# ---- Cadangan otomatis (lihat PANDUAN-CADANGAN.md) ----
# Kunci rahasia agar /api/backup hanya bisa dipicu oleh cron Vercel.
# Wajib diisi supaya cadangan harian aktif. Buat teks acak panjang.
CRON_SECRET=

# Google Drive lewat OAuth akun Anda sendiri (bukan service account).
# Dapatkan lewat: node tools/dapatkan-token-drive.js <CLIENT_ID> <CLIENT_SECRET>
GDRIVE_CLIENT_ID=
GDRIVE_CLIENT_SECRET=
GDRIVE_REFRESH_TOKEN=
# ID folder tujuan: bagian setelah /folders/ pada alamat folder di Drive
GDRIVE_FOLDER_ID=
