{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci --omit=dev --no-audit --no-fund --prefer-offline",
  "buildCommand": "echo \"Tidak ada build step: frontend statis + serverless functions\"",
  "outputDirectory": "src/public",
  "regions": [
    "sin1"
  ],
  "functions": {
    "api/**/*.js": {
      "maxDuration": 30
    },
    "api/wa-dispatch.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/backup",
      "schedule": "0 19 * * *"
    },
    {
      "path": "/api/wa-dispatch",
      "schedule": "0 1 * * *"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
